<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="SharpShot.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Resources/Colors.xaml" />
                <ResourceDictionary Source="ms-appx:///Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Brand accent: WinUI derives accent brushes (AccentButton, ToggleSwitch, NavigationView
                 selection indicator, focus visuals) from these system colours. -->
            <Color x:Key="SystemAccentColor">#FFAA35</Color>
            <Color x:Key="SystemAccentColorLight1">#FFB85C</Color>
            <Color x:Key="SystemAccentColorLight2">#FFC77E</Color>
            <Color x:Key="SystemAccentColorLight3">#FFD9A8</Color>
            <Color x:Key="SystemAccentColorDark1">#FF9A1F</Color>
            <Color x:Key="SystemAccentColorDark2">#FF7A00</Color>
            <Color x:Key="SystemAccentColorDark3">#D96600</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
