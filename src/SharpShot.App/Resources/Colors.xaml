<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand palette (docs/design-system). Theme-independent accent colours. -->
    <Color x:Key="BrandPrimaryColor">#FFAA35</Color>
    <Color x:Key="BrandPrimaryHoverColor">#FF7A00</Color>
    <Color x:Key="BrandSilverLightColor">#F5F7FA</Color>
    <Color x:Key="BrandSilverDarkColor">#C9D1DC</Color>
    <Color x:Key="BrandSuccessColor">#34D399</Color>
    <Color x:Key="BrandDangerColor">#F87171</Color>

    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimaryColor}" />
    <SolidColorBrush x:Key="BrandPrimaryHoverBrush" Color="{StaticResource BrandPrimaryHoverColor}" />
    <SolidColorBrush x:Key="BrandSuccessBrush" Color="{StaticResource BrandSuccessColor}" />
    <SolidColorBrush x:Key="BrandDangerBrush" Color="{StaticResource BrandDangerColor}" />

    <LinearGradientBrush x:Key="BrandPrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFAA35" Offset="0" />
        <GradientStop Color="#FF7A00" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrandSilverEdgeGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#9AA5B4" Offset="0" />
        <GradientStop Color="#6E7A8A" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrandSilverGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F5F7FA" Offset="0" />
        <GradientStop Color="#C9D1DC" Offset="1" />
    </LinearGradientBrush>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="AppBackgroundColor">#0D1017</Color>
            <Color x:Key="AppSurfaceColor">#1B2230</Color>
            <Color x:Key="AppSurfaceElevatedColor">#232C3D</Color>
            <Color x:Key="AppBorderColor">#2A3447</Color>
            <Color x:Key="AppTextPrimaryColor">#F5F7FA</Color>
            <Color x:Key="AppTextSecondaryColor">#94A3B8</Color>
            <Color x:Key="AppKeycapColor">#2A3447</Color>
            <Color x:Key="AppSidebarColor">#11161F</Color>
            <Color x:Key="AppCardPrimaryColor">#2A2418</Color>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="AppSurfaceElevatedBrush" Color="{StaticResource AppSurfaceElevatedColor}" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource AppBorderColor}" />
            <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="{StaticResource AppTextPrimaryColor}" />
            <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="{StaticResource AppTextSecondaryColor}" />
            <SolidColorBrush x:Key="AppKeycapBrush" Color="{StaticResource AppKeycapColor}" />
            <SolidColorBrush x:Key="AppSidebarBrush" Color="{StaticResource AppSidebarColor}" />
            <SolidColorBrush x:Key="AppCardPrimaryBrush" Color="{StaticResource AppCardPrimaryColor}" />
            <SolidColorBrush x:Key="AppLogoSilverBrush" Color="#F5F7FA" />

            <LinearGradientBrush x:Key="AppHeaderGlowBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#001B2230" Offset="0.45" />
                <GradientStop Color="#33FF7A00" Offset="0.85" />
                <GradientStop Color="#80FFAA35" Offset="1" />
            </LinearGradientBrush>

            <!-- Fluent control surfaces tuned to the palette -->
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#11161F" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#11161F" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#FFAA35" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#1B2230" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#232C3D" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#1B2230" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#F5F7FA" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#1B2230" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#2A3447" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#0D1017" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#0D1017" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#232C3D" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#2A3447" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#2A3447" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F5F7FA" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#94A3B8" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#0D1017" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0D1017" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#0D1017" />
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#FFAA35" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FF7A00" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#D96600" />
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FFAA35" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FF7A00" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#D96600" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#0D1017" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#0D1017" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#0D1017" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="AppBackgroundColor">#F5F7FA</Color>
            <Color x:Key="AppSurfaceColor">#FFFFFF</Color>
            <Color x:Key="AppSurfaceElevatedColor">#F1F5F9</Color>
            <Color x:Key="AppBorderColor">#D5DCE6</Color>
            <Color x:Key="AppTextPrimaryColor">#0D1017</Color>
            <Color x:Key="AppTextSecondaryColor">#5B6B80</Color>
            <Color x:Key="AppKeycapColor">#E6EBF2</Color>
            <Color x:Key="AppSidebarColor">#EDF1F6</Color>
            <Color x:Key="AppCardPrimaryColor">#FFF4E3</Color>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="AppSurfaceElevatedBrush" Color="{StaticResource AppSurfaceElevatedColor}" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource AppBorderColor}" />
            <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="{StaticResource AppTextPrimaryColor}" />
            <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="{StaticResource AppTextSecondaryColor}" />
            <SolidColorBrush x:Key="AppKeycapBrush" Color="{StaticResource AppKeycapColor}" />
            <SolidColorBrush x:Key="AppSidebarBrush" Color="{StaticResource AppSidebarColor}" />
            <SolidColorBrush x:Key="AppCardPrimaryBrush" Color="{StaticResource AppCardPrimaryColor}" />
            <SolidColorBrush x:Key="AppLogoSilverBrush" Color="#5B6B80" />

            <LinearGradientBrush x:Key="AppHeaderGlowBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#00FFFFFF" Offset="0.45" />
                <GradientStop Color="#22FF7A00" Offset="0.85" />
                <GradientStop Color="#55FFAA35" Offset="1" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#EDF1F6" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#EDF1F6" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#FF7A00" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#D5DCE6" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#F5F7FA" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#0D1017" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0D1017" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#0D1017" />
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#FFAA35" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FF7A00" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#D96600" />
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FF7A00" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FFAA35" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#D96600" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AppSurfaceElevatedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AppKeycapBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="AppSidebarBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AppCardPrimaryBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AppLogoSilverBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AppHeaderGlowBrush" Color="Transparent" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
