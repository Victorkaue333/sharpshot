<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SharpShot.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:SharpShot.App.Components"
    Background="{ThemeResource AppBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="2" HorizontalAlignment="Stretch">
            <TextBlock Text="Configurações" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,8" />

            <InfoBar IsOpen="{x:Bind ViewModel.IsInfoOpen, Mode=TwoWay}"
                     Severity="{x:Bind ViewModel.InfoSeverity, Mode=OneWay}"
                     Message="{x:Bind ViewModel.InfoMessage, Mode=OneWay}"
                     Margin="0,0,0,8" />

            <!-- Geral -->
            <TextBlock Text="Geral" Style="{StaticResource SectionTitleStyle}" />
            <Border Style="{StaticResource SettingsRowStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE7E8;" FontSize="18" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Iniciar com o Windows" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock Text="Abre o SharpShot na bandeja ao entrar no Windows." Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsRowStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE921;" FontSize="18" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Minimizar para a bandeja" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock Text="Fechar a janela mantém o SharpShot em segundo plano." Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsRowStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xEA8F;" FontSize="18" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Mostrar notificação após capturar" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock Text="Exibe o nome do arquivo com opções para abrir a imagem ou a pasta." Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.ShowNotification, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" />
                </Grid>
            </Border>

            <!-- Atalhos -->
            <TextBlock Text="Atalhos" Style="{StaticResource SectionTitleStyle}" />
            <Border Style="{StaticResource SettingsRowStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE7F4;" FontSize="18" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Capturar tela inteira" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
                    <components:HotkeyEditor Grid.Column="2" x:Name="FullScreenEditor"
                                             Hotkey="{x:Bind ViewModel.FullScreenHotkey, Mode=OneWay}"
                                             BindingCommitted="FullScreenEditor_BindingCommitted" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsRowStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE7A8;" FontSize="18" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Selecionar região" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
                    <components:HotkeyEditor Grid.Column="2" x:Name="RegionEditor"
                                             Hotkey="{x:Bind ViewModel.RegionHotkey, Mode=OneWay}"
                                             BindingCommitted="RegionEditor_BindingCommitted" />
                </Grid>
            </Border>
            <HyperlinkButton Content="Restaurar padrões" Command="{x:Bind ViewModel.RestoreDefaultHotkeysCommand}"
                             Foreground="{ThemeResource BrandPrimaryBrush}" Padding="4,2" />

            <!-- Salvamento -->
            <TextBlock Text="Salvamento" Style="{StaticResource SectionTitleStyle}" />
            <Border Style="{StaticResource SettingsRowStyle}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="18" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Pasta de destino" Style="{StaticResource BodyTextStyle}" />
                            <TextBlock Text="As capturas são salvas automaticamente nesta pasta." Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{x:Bind ViewModel.SaveDirectoryInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="{x:Bind ViewModel.DefaultDirectory}" AutomationProperties.Name="Pasta de destino" />
                        <Button Grid.Column="1" Content="Aplicar" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.ApplyDirectoryCommand}" />
                        <Button Grid.Column="2" Content="Abrir pasta" Style="{StaticResource GhostButtonStyle}" Command="{x:Bind ViewModel.OpenFolderCommand}" />
                        <Button Grid.Column="3" Content="Padrão" Style="{StaticResource GhostButtonStyle}" Command="{x:Bind ViewModel.ResetDirectoryCommand}"
                                ToolTipService.ToolTip="Voltar para Imagens\SharpShot" />
                    </Grid>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsRowStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE8AC;" FontSize="18" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="Convenção de nomes" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.NamingPattern}" Style="{StaticResource CaptionTextStyle}" FontFamily="Consolas" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}">
                            <Run Text="Exemplo: " /><Run Text="{x:Bind ViewModel.NamingExample}" FontFamily="Consolas" />
                        </TextBlock>
                        <TextBlock Text="Formato fixo: PNG sem perda de qualidade. Arquivos existentes nunca são sobrescritos." Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Aparência -->
            <TextBlock Text="Aparência" Style="{StaticResource SectionTitleStyle}" />
            <Border Style="{StaticResource SettingsRowStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE790;" FontSize="18" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Tema" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock Text="Escolha entre seguir o Windows, claro ou escuro." Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                    <ComboBox Grid.Column="2" MinWidth="220" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}" AutomationProperties.Name="Tema">
                        <ComboBoxItem Content="Seguir o sistema (Windows)" />
                        <ComboBoxItem Content="Tema claro" />
                        <ComboBoxItem Content="Tema escuro" />
                    </ComboBox>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
