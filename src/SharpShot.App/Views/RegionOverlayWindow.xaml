<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SharpShot.App.Views.RegionOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SharpShot.App.Views"
    Title="SharpShot — Selecionar região">

    <!-- The overlay is always dark regardless of the app theme. -->
    <local:SelectionSurface x:Name="Surface" RequestedTheme="Dark" IsTabStop="True" UseSystemFocusVisuals="False"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Grid x:Name="Root" Background="#0D1017">
            <!-- Frozen capture of this monitor, 1:1 with the physical pixels of the window. -->
            <Image x:Name="FrozenImage" Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <Canvas x:Name="Layer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <!-- Dim everything outside the selection (even-odd: outer rect minus selection). -->
                <Path x:Name="DimPath" Fill="#8C000000" />

                <!-- Selection border + handles -->
                <Rectangle x:Name="SelectionBorder" Stroke="#FFAA35" StrokeThickness="2" StrokeDashArray="6,3" Visibility="Collapsed" />
                <Rectangle x:Name="HandleTL" Style="{StaticResource HandleStyle}" />
                <Rectangle x:Name="HandleT" Style="{StaticResource HandleStyle}" />
                <Rectangle x:Name="HandleTR" Style="{StaticResource HandleStyle}" />
                <Rectangle x:Name="HandleR" Style="{StaticResource HandleStyle}" />
                <Rectangle x:Name="HandleBR" Style="{StaticResource HandleStyle}" />
                <Rectangle x:Name="HandleB" Style="{StaticResource HandleStyle}" />
                <Rectangle x:Name="HandleBL" Style="{StaticResource HandleStyle}" />
                <Rectangle x:Name="HandleL" Style="{StaticResource HandleStyle}" />

                <!-- Size badge -->
                <Border x:Name="SizeBadge" Style="{StaticResource OverlayPillStyle}" Visibility="Collapsed">
                    <TextBlock x:Name="SizeText" Text="0 × 0" FontSize="13" FontWeight="SemiBold" Foreground="#F5F7FA" />
                </Border>

                <!-- Toolbar -->
                <Border x:Name="Toolbar" Style="{StaticResource OverlayPillStyle}" Padding="8" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CaptureButton" Style="{StaticResource AccentButtonStyle}" CornerRadius="8" Padding="14,8"
                                Click="CaptureButton_Click" AutomationProperties.Name="Capturar região selecionada">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE73E;" FontSize="14" />
                                <TextBlock Text="Capturar" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CancelButton" Style="{StaticResource GhostButtonStyle}" Padding="14,8"
                                Click="CancelButton_Click" AutomationProperties.Name="Cancelar seleção">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE711;" FontSize="14" />
                                <TextBlock Text="Cancelar" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Hint shown before the first drag -->
                <Border x:Name="Hint" Style="{StaticResource OverlayPillStyle}" Padding="14,8">
                    <TextBlock Text="Clique e arraste para selecionar uma região · Enter captura · Esc cancela"
                               FontSize="13" Foreground="#F5F7FA" />
                </Border>
            </Canvas>
        </Grid>
    </local:SelectionSurface>
</Window>
